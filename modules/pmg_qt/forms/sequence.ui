<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Sequence</class>
 <widget class="QWidget" name="Sequence">
  <property name="windowTitle"><string>Sequence alignment</string></property>
  <layout class="QVBoxLayout" name="layout">
   <item><layout class="QHBoxLayout" name="inputs">
    <item><widget class="QPushButton" name="addChains"><property name="text"><string>&amp;Add chains…</string></property></widget></item>
    <item><widget class="QSpinBox" name="state"><property name="minimum"><number>0</number></property><property name="maximum"><number>1000000</number></property><property name="specialValueText"><string>Current state</string></property><property name="prefix"><string>State </string></property><property name="toolTip"><string>State to read when adding chains; zero uses the current state</string></property></widget></item>
    <item><widget class="QPushButton" name="importFasta"><property name="text"><string>&amp;Import FASTA…</string></property></widget></item>
    <item><widget class="QPushButton" name="removeRows"><property name="text"><string>&amp;Remove rows</string></property></widget></item>
    <item><widget class="QPushButton" name="exportFasta"><property name="text"><string>&amp;Export…</string></property></widget></item>
   </layout></item>
   <item><layout class="QHBoxLayout" name="alignment">
    <item><widget class="QPushButton" name="alignSequences"><property name="text"><string>Align &amp;sequences</string></property></widget></item>
    <item><widget class="QPushButton" name="mafft"><property name="text"><string>MAFFT…</string></property><property name="toolTip"><string>Choose the optional local MAFFT executable; otherwise mafft on PATH is used</string></property></widget></item>
    <item><widget class="QLabel" name="referenceLabel"><property name="text"><string>Reference:</string></property><property name="buddy"><cstring>reference</cstring></property></widget></item>
    <item><widget class="QComboBox" name="reference"/></item>
    <item><widget class="QComboBox" name="method"><property name="toolTip"><string>Structure fitting method</string></property><property name="accessibleName"><string>Structure fitting method</string></property></widget></item>
    <item><widget class="QPushButton" name="fitStructures"><property name="text"><string>&amp;Fit structures</string></property></widget></item>
    <item><widget class="QPushButton" name="stop"><property name="text"><string>Stop</string></property></widget></item>
    <item><widget class="QPushButton" name="undo"><property name="text"><string>&amp;Undo</string></property></widget></item>
   </layout></item>
   <item><layout class="QHBoxLayout" name="options">
    <item><widget class="QLineEdit" name="search"><property name="placeholderText"><string>Sequence or residue number; Enter to find</string></property><property name="accessibleName"><string>Find sequence or residue number</string></property></widget></item>
    <item><widget class="QPushButton" name="zoom"><property name="text"><string>&amp;Zoom selection</string></property></widget></item>
    <item><widget class="QPushButton" name="copy"><property name="text"><string>&amp;Copy</string></property></widget></item>
    <item><widget class="QComboBox" name="coloring"><property name="toolTip"><string>Color the residues: by kind (Zappo), by hydrophobicity (Kyte-Doolittle), or where they match the consensus</string></property><property name="accessibleName"><string>Residue colors</string></property></widget></item>
    <item><widget class="QCheckBox" name="secondary"><property name="text"><string>Secondary structure</string></property><property name="checked"><bool>true</bool></property></widget></item>
    <item><widget class="QPushButton" name="assignSS"><property name="text"><string>Assign SS</string></property><property name="toolTip"><string>Reassign secondary structure with dss for selected structure rows</string></property></widget></item>
    <item><widget class="QCheckBox" name="onlySelected"><property name="text"><string>Selected rows only</string></property></widget></item>
   </layout></item>
   <item><widget class="QLabel" name="legend"><property name="text"><string>∿ Helix   → Sheet   ─ Coil   ? Unassigned   · No coordinates. Bottom track: helices (cylinders) and strands (arrows) most rows share. Select cells to select residues in 3D; Ctrl adds.</string></property></widget></item>
   <item><widget class="QTableView" name="view"><property name="selectionMode"><enum>QAbstractItemView::ExtendedSelection</enum></property><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property></widget></item>
   <item><widget class="QPlainTextEdit" name="results"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>110</number></property><property name="accessibleName"><string>Alignment results</string></property></widget></item>
   <item><widget class="QLabel" name="status"><property name="text"><string>Add structure chains or import FASTA. Align sequences does not move structures.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
  </layout>
 </widget>
