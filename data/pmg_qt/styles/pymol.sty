#builder QPushButton
{
    padding:        1px 3px;
}

/* Room between the buttons, and a bold, slightly larger text in the first
   simple sans-serif the system has. The window opens at least as wide as
   this bar (pymol_qt_gui.py; docs/plans/20-toolbar-look.md). */
#toolbar_actions
{
    spacing:        8px;
    padding:        3px 6px;
}

#toolbar_actions QToolButton
{
    padding:        4px 4px;
    font-family:    "Inter", "Segoe UI", "Helvetica Neue", "Ubuntu", "Noto Sans", "Arial";
    font-size:      10pt;
    font-weight:    600;
}

/* The quick-select chips: letters in a thin frame, close together. */
#toolbar_actions QToolButton#chip
{
    padding:        3px 5px;
    min-width:      1em;
    border:         1px solid rgba(128, 128, 128, 0.45);
    border-radius:  5px;
}

#toolbar_actions QToolButton#chip::menu-indicator
{
    image:          none;
}

/* Blue for what is chosen and for what the pointer is on: the text of the
   selection mode, a checked button, a hovered button. palette(link) is a
   blue that reads on the window color of either theme; the icons follow in
   action_toolbar.py. */
#toolbar_actions QToolButton#selecting,
#toolbar_actions QToolButton:hover,
#toolbar_actions QToolButton:checked
{
    color:          palette(link);
}

/* the corners are see-through: theme.round_menus */
QMenu
{
    padding:        6px;
    border:         1px solid rgba(128, 128, 128, 0.45);
    border-radius:  10px;
    background-color: palette(window);
}

QMenu::item
{
    padding:        6px 28px 6px 12px;
    border-radius:  6px;
}

/* In every menu the pointed-at row has the blue of the A button of the
   Objects panel, and a chosen row is written in blue. */
QMenu::item:selected,
QMenuBar::item:selected
{
    background:     #1e4fb8;
    color:          white;
}

QMenu::item:checked
{
    color:          palette(link);
}

QMenu::item:checked:selected
{
    color:          white;
}

QMenu::item:disabled,
QMenu::item:disabled:selected
{
    background:     transparent;
    color:          palette(mid);
}

QMenuBar::item
{
    padding:        4px 8px;
    border-radius:  6px;
    background:     transparent;
}

QMenu::icon
{
    padding-left:   10px;
}

QMenu::separator
{
    height:         1px;
    margin:         5px 4px;
    background:     rgba(128, 128, 128, 0.35);
}

QLabel#menu_title
{
    padding:        4px 12px 6px 8px;
    font-weight:    600;
    color:          rgb(128, 128, 128);
}

QMainWindow::separator
{
    width:          5px;
    height:         5px;
    border:         none;
}

