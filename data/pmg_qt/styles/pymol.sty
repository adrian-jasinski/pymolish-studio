#builder QPushButton
{
    padding:        1px 3px;
}

/* 14 buttons with 20 px icons must fit the 940 px default window at 150 %:
   the bar is 932 px wide with these numbers (docs/plans/20-toolbar-look.md) */
#toolbar_actions
{
    spacing:        1px;
    padding:        2px 4px;
}

#toolbar_actions QToolButton
{
    padding:        4px 2px;
    font-weight:    500;
}

/* Blue for what is chosen and for what the pointer is on: the text of the
   selection mode, a checked button, a hovered button. palette(link) is a
   blue that reads on the window color of either theme; the icons follow in
   action_toolbar.py. */
#toolbar_actions QToolButton#selecting,
#toolbar_actions QToolButton:hover,
#toolbar_actions QToolButton:checked
{
    color:          palette(link);
}

/* In its menus the pointed-at row has the blue of the A button of the
   Objects panel, and the chosen row is written in blue. */
#toolbar_actions QMenu::item:selected
{
    background:     #1e4fb8;
    color:          white;
}

#toolbar_actions QMenu::item:checked
{
    color:          palette(link);
}

#toolbar_actions QMenu::item:checked:selected
{
    color:          white;
}

/* the corners are see-through: theme.round_menus */
QMenu
{
    padding:        6px;
    border:         1px solid rgba(128, 128, 128, 0.45);
    border-radius:  10px;
    background-color: palette(window);
}

QMenu::item
{
    padding:        6px 28px 6px 12px;
    border-radius:  6px;
}

QMenu::item:selected
{
    background:     rgba(128, 128, 128, 0.28);
    color:          palette(text);
}

QMenu::item:disabled
{
    color:          palette(mid);
}

QMenu::icon
{
    padding-left:   10px;
}

QMenu::separator
{
    height:         1px;
    margin:         5px 4px;
    background:     rgba(128, 128, 128, 0.35);
}

QLabel#menu_title
{
    padding:        4px 12px 6px 8px;
    font-weight:    600;
    color:          rgb(128, 128, 128);
}

QMainWindow::separator
{
    width:          5px;
    height:         5px;
    border:         none;
}

